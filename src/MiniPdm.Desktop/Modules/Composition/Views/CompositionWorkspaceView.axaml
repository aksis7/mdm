<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiniPdm.Desktop.Modules.Composition.ViewModels"
             xmlns:mainVm="using:MiniPdm.Desktop.ViewModels"
             x:DataType="mainVm:MainWindowViewModel"
             x:Class="MiniPdm.Desktop.Modules.Composition.Views.CompositionWorkspaceView">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="10">
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="Действующий состав" Classes="heading"/>
        <TreeView ItemsSource="{Binding Composition.TreeRoots}" SelectedItem="{Binding Composition.SelectedTreeNode, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}">
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="{x:Type vm:TreeOccurrenceViewModel}" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
        <Border x:Name="CompositionEditor" Classes="card" IsVisible="{Binding IsAssembly}" IsEnabled="{Binding CanEditCompositionUi}">
          <StackPanel Spacing="7">
            <TextBlock Text="Редактируемый состав версии" Classes="heading"/>
            <TextBlock Text="{Binding SelectedVersionLabel}" FontWeight="SemiBold"/>
            <TextBlock Text="Выберите дочерние объекты и задайте целые количества. Сохранение заменяет состав целиком." Classes="muted" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Width="220" Text="{Binding ChildSearchText, UpdateSourceTrigger=PropertyChanged}" Watermark="Поиск компонента"/>
              <Button Content="Искать" Command="{Binding SearchChildrenCommand}"/>
            </StackPanel>
            <ListBox Height="110" ItemsSource="{Binding Composition.ChildResults}" SelectedItem="{Binding Composition.SelectedChild, Mode=TwoWay}">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Добавить выбранный компонент" Command="{Binding Composition.AddChildCommand}" HorizontalAlignment="Left"/>
            <ListBox Height="180" ItemsSource="{Binding Composition.Components}" SelectedItem="{Binding Composition.SelectedComponent, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,100" Margin="0,3">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay}" Watermark="Количество"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Удалить строку" Command="{Binding Composition.RemoveChildCommand}"/>
              <Button Content="Сохранить состав" Command="{Binding SaveCompositionCommand}" Classes="primary"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="Расчёт действующего состава" Classes="heading"/>
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="Итоговая масса, кг" Classes="muted"/>
            <TextBlock Text="{Binding Composition.TotalMassKg}" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Расчёт неполон: см. диагностику ниже." Foreground="#9A3412" IsVisible="{Binding !Composition.CalculationComplete}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Диагностика" Classes="heading"/>
        <ItemsControl ItemsSource="{Binding Composition.Diagnostics}">
          <ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,2"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Спецификация" Classes="heading"/>
        <ItemsControl ItemsSource="{Binding Composition.Specification}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,2">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Designation}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                  <TextBlock Classes="muted" FontSize="11"><Run Text="Кол-во: "/><Run Text="{Binding Quantity}"/><Run Text=" · кг: "/><Run Text="{Binding TotalMassKg}"/></TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
