<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiniPdm.Desktop.Modules.BackgroundTasks.Views.BackgroundTasksView">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Text="Фоновые задачи" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Обновить" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding State}" />
              <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Интервал (минуты)" VerticalAlignment="Center" />
        <TextBox Width="120" IsEnabled="{Binding IsScheduleEditable}" Text="{Binding IntervalMinutesText, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Сохранить расписание" Command="{Binding SaveScheduleCommand}" />
        <Button Content="Запустить" Command="{Binding RunCommand}" />
      </StackPanel>
      <TextBlock Text="Следующий запуск" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedTask.NextRunAt}" />
      <TextBlock Text="Последний запуск" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedTask.LastStartedAt}" />
      <TextBlock Text="Последнее завершение" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedTask.LastCompletedAt}" />
      <TextBlock Text="Результат" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedTask.LastResult}" TextWrapping="Wrap" />
      <TextBlock Text="Ошибка" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedTask.LastError}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
